# API NestJS + Prisma cho máy chủ thật (build từ thư mục gốc của dự án)
FROM node:24-bookworm-slim
# poppler-utils (pdftoppm): chuyển trang đầu bảng đón PDF thành ảnh cho app lái xe
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tzdata poppler-utils && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Ho_Chi_Minh
WORKDIR /app

# Cài thư viện trước để Docker dùng lại cache khi chỉ sửa code
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci -w api --no-audit --no-fund

COPY apps/api apps/api
WORKDIR /app/apps/api
RUN npx prisma generate && npm run build

ENV NODE_ENV=production PORT=3000 UPLOAD_DIR=/data/uploads
VOLUME /data/uploads
EXPOSE 3000
# Mỗi lần khởi động: áp dụng các thay đổi cơ sở dữ liệu còn thiếu rồi chạy API
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main"]
