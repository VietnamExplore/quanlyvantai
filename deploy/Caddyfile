# Hai tên miền (lấy từ deploy/.env), Caddy tự xin và gia hạn chứng chỉ HTTPS miễn phí:
#   OFFICE_DOMAIN  – phần mềm điều hành của công ty (vd dieuxe.vietnamexplore.vn)
#   PARTNER_DOMAIN – cổng nhà xe đối tác nhận chuyến (vd nhaxe.vietnamexplore.vn), mở thẳng /partner
# Chạy thử không có tên miền: OFFICE_DOMAIN=:80, PARTNER_DOMAIN=:8081 (chỉ http).

(app) {
	encode zstd gzip

	# Cho phép tải lên file bảng đón khách tới 100 MB
	request_body {
		max_size 105MB
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Ứng dụng 1 trang: mọi đường dẫn không phải file đều trả về index.html
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Trang ứng dụng (/, /dispatch, /bookings/…: đều là index.html) luôn hỏi lại máy chủ để nhận bản mới sau mỗi lần cập nhật
	@html not path /assets/* /api/*
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$OFFICE_DOMAIN} {
	import app
}

{$PARTNER_DOMAIN} {
	# Tên miền nhà xe chỉ dùng cổng nhà xe (và các trang công khai: hợp đồng / lệnh vận chuyển điện tử)
	@office not path /partner /partner/* /api/* /assets/* /e/* /favicon* /*.png /*.svg /*.ico /*.webmanifest
	redir @office /partner 302
	import app
}
