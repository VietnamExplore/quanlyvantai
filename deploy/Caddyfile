# DOMAIN lấy từ file .env, ví dụ: xe.congtycuaban.vn → Caddy tự xin và gia hạn chứng chỉ HTTPS miễn phí.
# Chạy thử không có tên miền: DOMAIN=:80 (chỉ http).
{$DOMAIN} {
	encode zstd gzip

	# Cho phép tải lên file bảng đón khách tới 100 MB
	request_body {
		max_size 105MB
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Ứng dụng 1 trang: mọi đường dẫn không phải file đều trả về index.html
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Trang ứng dụng (/, /dispatch, /bookings/…: đều là index.html) luôn hỏi lại máy chủ để nhận bản mới sau mỗi lần cập nhật
	@html not path /assets/* /api/*
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
