# Sao chép thành deploy/.env rồi điền giá trị.  KHÔNG đưa file .env lên Git.

# Tên miền trỏ về IP của VPS (bản ghi A). Caddy tự cấp HTTPS cho tên miền này.
# Chạy thử chưa có tên miền: DOMAIN=:80  (truy cập http://IP-của-VPS)
DOMAIN=xe.congtycuaban.vn

# Mật khẩu cơ sở dữ liệu – chuỗi ngẫu nhiên dài, chỉ chữ và số
#   tạo bằng lệnh:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Chuỗi bí mật ký token đăng nhập – chuỗi ngẫu nhiên dài
#   tạo bằng lệnh:  openssl rand -hex 48
JWT_SECRET=

# Thời hạn đăng nhập (giây): 7 ngày
JWT_EXPIRES_IN_SECONDS=604800

# Chỉ dùng khi KHỞI TẠO dữ liệu mới bằng lệnh seed (không dùng nếu chuyển dữ liệu từ máy văn phòng lên).
# Đổi mật khẩu admin ngay sau lần đăng nhập đầu tiên.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Cổng (giữ nguyên trên VPS)
HTTP_PORT=80
HTTPS_PORT=443
