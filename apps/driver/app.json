{
  "expo": {
    "name": "Lái Xe",
    "slug": "lai-xe",
    "version": "1.5.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.vantai.laixe",
      "buildNumber": "5",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "vi",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Kết nối tới máy chủ phần mềm điều xe của công ty trong mạng nội bộ (ví dụ 192.168.1.217).",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "vn.vantai.laixe",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#1278FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1668dc"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép chụp ảnh hóa đơn, vé cầu đường để gửi văn phòng.",
          "photosPermission": "Cho phép chọn ảnh hóa đơn có sẵn trong máy.",
          "microphonePermission": false
        }
      ],
      "expo-screen-orientation"
    ],
    "extra": {
      "eas": {
        "projectId": "e228ec5e-f7a3-4afe-b2a0-ec013ca10493"
      }
    },
    "owner": "vietnamexplore"
  }
}
