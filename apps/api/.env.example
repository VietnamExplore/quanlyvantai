# Sao chép file này thành .env rồi sửa giá trị cho phù hợp
DATABASE_URL="postgresql://transfer:transfer@localhost:5432/transfer?schema=public"
PORT=3000

# Chuỗi bí mật ký token đăng nhập: BẮT BUỘC đổi khi chạy thật
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai"
# Thời hạn đăng nhập (giây): 7 ngày
JWT_EXPIRES_IN_SECONDS=604800

# Tài khoản admin tạo lần đầu khi chạy seed (đổi mật khẩu ngay sau khi đăng nhập)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
