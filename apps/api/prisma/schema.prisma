generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Người dùng & phân quyền ─────────────

enum Role {
  ADMIN
  DIEU_HANH
  KINH_DOANH
  KE_TOAN
  LAI_XE
  NHA_XE // Tài khoản nhà xe đối tác: chỉ thấy chuyến giao cho nhà xe mình
}

model User {
  id               Int                 @id @default(autoincrement())
  username         String              @unique
  passwordHash     String
  fullName         String
  phone            String?
  email            String?
  roles            Role[]
  isActive         Boolean             @default(true)
  pushToken        String? // Expo push token của app lái xe
  /// Admin đã xóa (tài khoản có dữ liệu cũ thì giữ lại để không mất lịch sử, ẩn khỏi danh sách)
  deletedAt        DateTime?
  driver           Driver?
  /// Tài khoản nhà xe đối tác (vai trò NHA_XE)
  partnerId        Int?
  partner          Partner?            @relation(fields: [partnerId], references: [id])
  customers        Customer[]          @relation("SalesOwner")
  salesBookings    Booking[]           @relation("BookingSales")
  createdBookings  Booking[]           @relation("BookingCreator")
  contracts        TransportContract[] @relation("ContractCreator")
  assignedTrips    BookingTrip[]       @relation("TripAssigner")
  tripCosts        TripCost[]          @relation("CostCreator")
  payments         Payment[]           @relation("PaymentCreator")
  partnerPayments  PartnerPayment[]    @relation("PartnerPaymentCreator")
  cashVouchers     CashVoucher[]       @relation("VoucherCreator")
  tripEvents       TripEvent[]
  decidedAdvances  AdvanceRequest[]    @relation("AdvanceDecider")
  notifications    Notification[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  handledIncidents FieldIncident[]     @relation("IncidentHandler")
}

// ───────────── Xe ─────────────

model VehicleType {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  name           String
  seats          Int // Tổng số chỗ, gồm cả ghế lái
  maxPassengers  Int
  licenseClasses String[] // Hạng bằng lái phù hợp, Admin tự cấu hình
  /// Tên trên giấy tờ gửi khách nước ngoài: { "en": "...", "ko": "...", "zh": "...", "ja": "..." }
  names          Json             @default("{}")
  isActive       Boolean          @default(true)
  /// Định mức xăng dầu của loại xe (lít/100km); trống = 11
  fuelNorm       Decimal?         @db.Decimal(5, 2)
  vehicles       Vehicle[]
  routePrices    RoutePriceItem[]
  rentalRate     RentalRate?
  trips          BookingTrip[]
  shuttleRoutes  ShuttleRoute[]
  shuttleRuns    ShuttleRun[]
}

enum Ownership {
  CONG_TY
  DOI_TAC
}

enum VehicleStatus {
  SAN_SANG
  BAO_DUONG
  NGUNG_HOAT_DONG
}

model Vehicle {
  id                 Int             @id @default(autoincrement())
  plateNumber        String          @unique
  vehicleTypeId      Int
  vehicleType        VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  brand              String?
  model              String?
  year               Int?
  color              String?
  ownership          Ownership       @default(CONG_TY)
  partnerId          Int?
  partner            Partner?        @relation(fields: [partnerId], references: [id])
  status             VehicleStatus   @default(SAN_SANG)
  registrationExpiry DateTime?       @db.Date // Hạn đăng kiểm
  insuranceExpiry    DateTime?       @db.Date // Hạn bảo hiểm
  badgeExpiry        DateTime?       @db.Date // Hạn phù hiệu
  odometerKm         Int?
  /// Định mức xăng dầu riêng của xe (lít/100km); trống = theo loại xe
  fuelNorm           Decimal?        @db.Decimal(5, 2)
  defaultDriverId    Int?
  defaultDriver      Driver?         @relation(fields: [defaultDriverId], references: [id])
  trips              BookingTrip[]
  shuttleRuns        ShuttleRun[]
  vouchers           CashVoucher[]
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  incidents          FieldIncident[]
  checks             VehicleCheck[]
}

// ───────────── Lái xe ─────────────

enum DriverStatus {
  DANG_LAM
  NGHI_PHEP
  NGHI_VIEC
}

model Driver {
  id                Int              @id @default(autoincrement())
  fullName          String
  phone             String
  idCardNumber      String?
  licenseClass      String?
  licenseNumber     String?
  licenseExpiry     DateTime?        @db.Date
  healthCheckExpiry DateTime?        @db.Date
  partnerId         Int? // null = lái xe công ty
  partner           Partner?         @relation(fields: [partnerId], references: [id])
  status            DriverStatus     @default(DANG_LAM)
  userId            Int?             @unique
  user              User?            @relation(fields: [userId], references: [id])
  defaultVehicles   Vehicle[]
  trips             BookingTrip[]
  shuttleRuns       ShuttleRun[]
  salaries          DriverSalary[]
  fuelVouchers      CashVoucher[]
  advanceRequests   AdvanceRequest[]
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  incidents         FieldIncident[]
  vehicleChecks     VehicleCheck[]
}

/// Mức lương lái xe công ty theo thời gian: lương cứng / tháng + % doanh thu chuyến đã chạy.
/// Mức áp dụng cho một tháng = bản ghi có effectiveFrom gần nhất <= ngày đầu tháng đó.
model DriverSalary {
  id                Int      @id @default(autoincrement())
  driverId          Int
  driver            Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime @db.Date // luôn là ngày 01 của tháng bắt đầu áp dụng
  baseSalary        Decimal  @db.Decimal(14, 0)
  commissionPercent Decimal  @db.Decimal(5, 2)
  note              String?
  createdById       Int?
  createdAt         DateTime @default(now())

  @@unique([driverId, effectiveFrom])
}

// ───────────── Nhà xe đối tác ─────────────

model Partner {
  id               Int              @id @default(autoincrement())
  name             String
  contactName      String?
  phone            String?
  zalo             String?
  taxCode          String?
  address          String?
  bankName         String?
  bankAccount      String?
  vehicleTypeCodes String[] // Loại xe đối tác cung cấp được, ví dụ ["XE29","XE45"]
  rating           Int? // 1–5
  notes            String?
  isActive         Boolean          @default(true)
  vehicles         Vehicle[]
  drivers          Driver[]
  trips            BookingTrip[]
  shuttleRuns      ShuttleRun[]
  payments         PartnerPayment[]
  vouchers         CashVoucher[]
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// ───────────── Khách hàng ─────────────

/// Danh mục loại khách hàng (Khách lẻ, Doanh nghiệp, Đại lý…); thêm mới được
model CustomerKind {
  code      String     @id
  name      String
  /// Màu thẻ (antd preset: blue, purple, cyan…)
  color     String?
  /// Khách loại này hưởng giá đại lý (xe ghép) và nguồn booking mặc định Đại lý
  isAgent   Boolean    @default(false)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  customers Customer[]
}

model Customer {
  id                     Int          @id @default(autoincrement())
  /// Mã loại khách hàng (danh mục CustomerKind)
  type                   String       @default("KHACH_LE")
  kind                   CustomerKind @relation(fields: [type], references: [code], onUpdate: Cascade)
  name                   String
  phone                  String?
  email                  String?
  taxCode                String?
  address                String?
  /// Thông tin Bên A trên hợp đồng vận chuyển (NĐ 158/2024 Điều 17)
  idNumber               String? // Số CCCD / hộ chiếu (khách cá nhân)
  representative         String? // Người đại diện ký hợp đồng (tổ chức)
  representativeTitle    String?
  representativeIdNumber String?
  bankAccount            String? // Tài khoản ngân hàng (số TK, ngân hàng, chủ TK)
  salesUserId            Int?
  salesUser              User?        @relation("SalesOwner", fields: [salesUserId], references: [id])
  creditLimit            Decimal?     @db.Decimal(15, 0) // Hạn mức công nợ (VND)
  discountPercent        Decimal?     @db.Decimal(5, 2)
  paymentTermDays        Int          @default(0) // Số ngày được nợ sau khi kết thúc chuyến
  notes                  String?
  /// Ngôn ngữ giấy tờ mặc định cho booking của khách: vi | en | ko | zh | ja
  docLanguage            String       @default("vi")
  isActive               Boolean      @default(true)
  bookings               Booking[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

// ───────────── Địa điểm ─────────────

enum LocationType {
  SAN_BAY
  KHACH_SAN
  DIEM_THAM_QUAN
  BEN_XE
  KHAC
}

model Location {
  id           Int           @id @default(autoincrement())
  name         String
  type         LocationType  @default(KHAC)
  address      String?
  lat          Float?
  lng          Float?
  isActive     Boolean       @default(true)
  routesFrom   RoutePrice[]  @relation("RouteFrom")
  routesTo     RoutePrice[]  @relation("RouteTo")
  tripPickups  BookingTrip[] @relation("TripPickup")
  tripDropoffs BookingTrip[] @relation("TripDropoff")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ───────────── Bảng giá ─────────────

enum PricingMode {
  TUYEN // Tính theo giá tuyến
  THEO_NGAY // Tính theo giá thuê ngày khi không chọn tuyến
  XE_GHEP // Bán từng chỗ trên chuyến xe ghép (shuttle bus) theo giá vé của tuyến
}

/// Danh mục dịch vụ (đón tiễn sân bay, city tour, thuê xe theo ngày…) do Admin quản lý
model Service {
  code        String        @id // Mã, ví dụ DON_TIEN_SAN_BAY
  name        String
  pricingMode PricingMode   @default(TUYEN)
  hasFlight   Boolean       @default(false) // Hiện ô số hiệu chuyến bay
  color       String? // Màu nhãn hiển thị
  /// Tên trên giấy tờ gửi khách nước ngoài: { "en": "...", "ko": "...", "zh": "...", "ja": "..." }
  names       Json          @default("{}")
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  routes      RoutePrice[]
  trips       BookingTrip[]
}

/// Giá theo tuyến: mỗi tuyến có giá bán riêng cho từng loại xe
model RoutePrice {
  id             Int              @id @default(autoincrement())
  name           String
  serviceType    String           @default("THEO_TUYEN")
  service        Service          @relation(fields: [serviceType], references: [code], onUpdate: Cascade)
  fromLocationId Int?
  fromLocation   Location?        @relation("RouteFrom", fields: [fromLocationId], references: [id])
  toLocationId   Int?
  toLocation     Location?        @relation("RouteTo", fields: [toLocationId], references: [id])
  distanceKm     Int?
  durationHours  Decimal?         @db.Decimal(5, 1) // Thời gian chạy dự kiến, dùng để tính giờ kết thúc chuyến
  notes          String?
  isActive       Boolean          @default(true)
  items          RoutePriceItem[]
  trips          BookingTrip[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model RoutePriceItem {
  id            Int         @id @default(autoincrement())
  routePriceId  Int
  routePrice    RoutePrice  @relation(fields: [routePriceId], references: [id], onDelete: Cascade)
  vehicleTypeId Int
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  price         Decimal     @db.Decimal(15, 0) // Giá bán
  partnerCost   Decimal?    @db.Decimal(15, 0) // Giá mua đối tác tham khảo

  @@unique([routePriceId, vehicleTypeId])
}

/// Giá thuê theo ngày cho từng loại xe
model RentalRate {
  id                 Int         @id @default(autoincrement())
  vehicleTypeId      Int         @unique
  vehicleType        VehicleType @relation(fields: [vehicleTypeId], references: [id])
  fullDayPrice       Decimal     @db.Decimal(15, 0)
  fullDayHours       Int         @default(10)
  fullDayKm          Int         @default(100)
  halfDayPrice       Decimal?    @db.Decimal(15, 0)
  halfDayHours       Int         @default(4)
  halfDayKm          Int         @default(50)
  extraKmPrice       Decimal     @default(0) @db.Decimal(15, 0)
  extraHourPrice     Decimal     @default(0) @db.Decimal(15, 0)
  driverOvernightFee Decimal     @default(0) @db.Decimal(15, 0)
  /// Các kiểu giá thêm do người dùng tự thêm dòng, ví dụ [{ "name": "Thuê 4 tiếng", "price": 700000, "hours": 4, "km": 40 }]
  extraOptions       Json        @default("[]")
  updatedAt          DateTime    @updatedAt
}

enum SurchargeRule {
  BAN_DEM // Tự động khi giờ đón trong khung đêm
  LE_TET // Tự động khi ngày đón trong danh sách ngày lễ
  THU_CONG // Nhân viên chọn tay
}

model Surcharge {
  id        Int           @id @default(autoincrement())
  name      String
  rule      SurchargeRule @default(THU_CONG)
  isPercent Boolean       @default(true) // true: % giá chuyến; false: số tiền cố định
  value     Decimal       @db.Decimal(15, 2)
  isActive  Boolean       @default(true)
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
}

/// Cài đặt chung dạng khóa – giá trị (thông tin công ty in trên báo giá…)
model Setting {
  key   String @id
  value String
}

// ───────────── Booking ─────────────

/// Nguồn khách của booking (Hotline, Zalo, OTA…): danh mục do người dùng quản lý, khóa theo mã
model CustomerSource {
  code      String    @id
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  bookings  Booking[]
}

enum BookingStatus {
  NHAP
  BAO_GIA
  XAC_NHAN
  HOAN_THANH
  HUY
}

enum TripStatus {
  CHO_DIEU
  DA_GAN
  TAI_XE_NHAN
  DANG_DEN_DON
  DA_DON_KHACH
  HOAN_THANH
  HUY
}

model Booking {
  id              Int                @id @default(autoincrement())
  code            String             @unique
  customerRef     String? // Mã booking của khách / đại lý (nếu có), dùng để đối chiếu
  /// Ngôn ngữ giấy tờ gửi khách: vi | en | ko | zh | ja
  docLanguage     String             @default("vi")
  /// Bản dịch nội dung booking cho giấy tờ ngoại ngữ: { "en": { "trip.12.pickupAddress": { "src": "…", "text": "…" } } }
  docTranslations Json               @default("{}")
  /// Người liên hệ trong chuyến: HDV (hướng dẫn viên) | TRUONG_DOAN (trưởng đoàn, thường là 1 khách trong đoàn)
  leaderRole      String?
  leaderName      String?
  leaderPhone     String?
  /// Ứng dụng liên lạc với HDV / trưởng đoàn: ZALO | WHATSAPP | KAKAOTALK | WECHAT | LINE | VIBER | TELEGRAM (trống = tự đoán theo đầu số)
  leaderApp       String?
  leaderAppId     String? // ID trên ứng dụng nếu khác SĐT (KakaoTalk ID, WeChat ID, LINE ID…)
  customerId      Int?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  contactName     String
  contactPhone    String
  source          String             @default("HOTLINE")
  sourceRef       CustomerSource     @relation(fields: [source], references: [code], onUpdate: Cascade)
  status          BookingStatus      @default(NHAP)
  salesUserId     Int?
  salesUser       User?              @relation("BookingSales", fields: [salesUserId], references: [id])
  discountAmount  Decimal            @default(0) @db.Decimal(15, 0)
  /// Khách lấy hóa đơn VAT: giá chuyến là giá chưa thuế, tổng cộng = (tạm tính − giảm giá) × (1 + thuế suất)
  invoiceRequired Boolean            @default(false)
  vatPercent      Decimal            @default(0) @db.Decimal(5, 2)
  /// Thông tin xuất hóa đơn cho khách (mặc định lấy từ hồ sơ khách hàng)
  invoiceCompany  String?
  invoiceTaxCode  String?
  invoiceAddress  String?
  invoiceEmail    String?
  depositAmount   Decimal            @default(0) @db.Decimal(15, 0)
  quoteValidUntil DateTime?          @db.Date
  notes           String? // Ghi chú cho khách (in trên báo giá)
  internalNotes   String? // Ghi chú nội bộ
  cancelReason    String?
  createdById     Int
  createdBy       User               @relation("BookingCreator", fields: [createdById], references: [id])
  trips           BookingTrip[]
  passengers      BookingPassenger[]
  contract        TransportContract?
  payments        Payment[]
  signTitle       String? // Dòng chính trên bảng đón khách
  signSubtitle    String? // Dòng phụ trên bảng đón khách
  signFile        String? // Tên file bảng đón khách gửi (lưu trong thư mục uploads/signs)
  signFileName    String? // Tên file gốc
  signFileType    String? // image/png, image/jpeg, image/webp, application/pdf
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model BookingTrip {
  id                Int         @id @default(autoincrement())
  bookingId         Int
  booking           Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seq               Int
  serviceType       String
  service           Service     @relation(fields: [serviceType], references: [code], onUpdate: Cascade)
  pickupTime        DateTime
  endTime           DateTime // Giờ kết thúc dự kiến, dùng để kiểm tra trùng lịch khi điều xe
  pickupLocationId  Int?
  pickupLocation    Location?   @relation("TripPickup", fields: [pickupLocationId], references: [id])
  pickupAddress     String
  dropoffLocationId Int?
  dropoffLocation   Location?   @relation("TripDropoff", fields: [dropoffLocationId], references: [id])
  dropoffAddress    String?
  flightNumber      String? // Số hiệu chuyến bay đón (khách đến)
  departureFlight   String? // Số hiệu chuyến bay tiễn (khách về)
  passengers        Int
  vehicleTypeId     Int
  vehicleType       VehicleType @relation(fields: [vehicleTypeId], references: [id])
  routePriceId      Int?
  routePrice        RoutePrice? @relation(fields: [routePriceId], references: [id])
  days              Int         @default(1)
  extraKm           Int         @default(0)
  extraHours        Int         @default(0)
  unitPrice         Decimal     @db.Decimal(15, 0) // Giá cơ bản của chuyến
  surcharges        Json        @default("[]") // [{ name, amount }]
  amount            Decimal     @db.Decimal(15, 0) // = unitPrice + tổng phụ thu
  estimatedCost     Decimal?    @db.Decimal(15, 0) // Chi phí dự kiến (giá thuê đối tác / chi phí xe công ty), dùng tính lợi nhuận
  itinerary         String? // Lịch trình chi tiết
  notes             String?
  status            TripStatus  @default(CHO_DIEU)

  // ── Điều xe ──
  vehicleId              Int? // Xe công ty
  vehicle                Vehicle?        @relation(fields: [vehicleId], references: [id])
  driverId               Int? // Lái xe công ty
  driver                 Driver?         @relation(fields: [driverId], references: [id])
  partnerId              Int? // Giao cho nhà xe đối tác
  partner                Partner?        @relation(fields: [partnerId], references: [id])
  partnerPlate           String?
  partnerDriverName      String?
  partnerDriverPhone     String?
  partnerCost            Decimal?        @db.Decimal(15, 0) // Giá thuê đối tác thực tế
  /// Nhà xe đối tác phải xuất hóa đơn cho công ty (thông tin công ty + email nhận hóa đơn hiện trên cổng nhà xe)
  partnerInvoice         Boolean         @default(false)
  /// Thuế suất trên hóa đơn nhà xe xuất: giá thuê là giá chưa thuế, công nợ nhà xe = giá thuê × (1 + thuế suất)
  partnerVatPercent      Decimal         @default(0) @db.Decimal(5, 2)
  /// Sự cố của nhà xe ở chuyến này: TRE_GIO (đón trễ) | KHONG_DON (không đón khách) – ghi khi văn phòng điều chỉnh giá
  partnerIssue           String?
  /// Ghi chú lần điều chỉnh giá nhà xe gần nhất (lý do, hiện cho nhà xe)
  partnerAdjustNote      String?
  /// Giá phát sinh nhà xe (trước thuế), nhập khi hoàn thành chuyến: công nợ = (giá thuê + tăng − giảm) × (1 + thuế suất)
  partnerExtraUp         Decimal         @default(0) @db.Decimal(15, 0)
  partnerExtraDown       Decimal         @default(0) @db.Decimal(15, 0)
  partnerExtraNote       String?
  /// Duyệt phát sinh: CHO_DUYET | DA_DUYET | TU_CHOI. Chỉ phát sinh DA_DUYET mới tính vào công nợ / lợi nhuận
  partnerExtraStatus     String?
  partnerExtraReviewNote String?
  partnerExtraReviewedBy String?
  partnerExtraReviewedAt DateTime?
  partnerInvoiceNote     String?
  dispatchNote           String? // Ghi chú cho tài xế / nhà xe
  /// Xe ghép: lượt đặt chỗ thuộc chuyến xe ghép (điều xe theo cả chuyến ghép)
  shuttleRunId           Int?
  shuttleRun             ShuttleRun?     @relation(fields: [shuttleRunId], references: [id])
  shuttlePickupStopId    Int?
  shuttlePickupStop      ShuttleStop?    @relation("ShuttlePickup", fields: [shuttlePickupStopId], references: [id], onDelete: SetNull)
  shuttleDropoffStopId   Int?
  shuttleDropoffStop     ShuttleStop?    @relation("ShuttleDropoff", fields: [shuttleDropoffStopId], references: [id], onDelete: SetNull)
  /// Số trẻ em trong số khách (giá vé trẻ em)
  childCount             Int             @default(0)
  /// Cự ly hành trình (km) ghi trên hợp đồng vận chuyển; trống = theo bảng giá tuyến
  distanceKm             Int?
  /// Ký nhận điện tử: khách (trưởng đoàn / HDV) ký trên điện thoại lái xe xác nhận đã hoàn thành chuyến
  signoffName            String?
  signoffAt              DateTime?
  /// Nét chữ ký dạng SVG path (khung 600×300)
  signoffSvg             String?
  signoffNote            String?
  incidents              FieldIncident[]

  /// Văn phòng nhờ lái xe thu tiền khách giúp
  collectAmount    Decimal?       @db.Decimal(15, 0)
  collectNote      String?
  collectedAt      DateTime? // Lái xe bấm "đã thu tiền"
  collectedAmount  Decimal?       @db.Decimal(15, 0)
  collectMethod    PaymentMethod?
  collectPaymentId Int?           @unique // Phiếu thu tự tạo khi lái xe xác nhận
  collectPayment   Payment?       @relation("TripCollect", fields: [collectPaymentId], references: [id], onDelete: SetNull)
  collectSettledAt DateTime? // Văn phòng đã nhận lại tiền từ lái xe
  /// Đồng hồ km của xe: km bắt đầu = km kết thúc chuyến trước của xe
  startKm          Int?
  endKm            Int?
  /// Chi phí xăng theo định mức, chốt lúc ghi km kết thúc (lít/100km, đ/lít)
  fuelNorm         Decimal?       @db.Decimal(5, 2)
  fuelPrice        Decimal?       @db.Decimal(10, 0)
  fuelLiters       Decimal?       @db.Decimal(8, 2)
  fuelCost         Decimal?       @db.Decimal(15, 0)
  assignedAt       DateTime?
  assignedById     Int?
  assignedBy       User?          @relation("TripAssigner", fields: [assignedById], references: [id])
  events           TripEvent[]
  costs            TripCost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pickupTime])
  @@index([vehicleId, pickupTime])
  @@index([driverId, pickupTime])
  @@index([shuttleRunId])
}

/// Danh sách hành khách của booking (in kèm lệnh vận chuyển xe hợp đồng)
model BookingPassenger {
  id          Int     @id @default(autoincrement())
  bookingId   Int
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seq         Int
  fullName    String
  gender      String? // NAM | NU
  birthYear   Int?
  idNumber    String? // CCCD / hộ chiếu
  nationality String?
  phone       String?
  note        String?

  @@index([bookingId])
}

/// Nhật ký thay đổi trạng thái / điều xe của chuyến
/// Hợp đồng vận chuyển hành khách (NĐ 158/2024 Điều 7, 17): mỗi booking một hợp đồng, kèm danh sách hành khách (TT 36/2024 Phụ lục V).
/// Lưu ít nhất 3 năm: không xóa khi hủy booking.
model TransportContract {
  id                  Int       @id @default(autoincrement())
  bookingId           Int       @unique
  booking             Booking   @relation(fields: [bookingId], references: [id])
  /// Số hợp đồng: 0001/2026/HĐVC (seq đánh lại từ 1 mỗi năm)
  number              String    @unique
  year                Int
  seq                 Int
  signedDate          DateTime  @db.Date
  /// Bên thuê vận tải (tổ chức hoặc cá nhân)
  hirerName           String
  hirerIdNumber       String? // Số CCCD / định danh cá nhân (người thuê là cá nhân)
  hirerTaxCode        String?
  hirerAddress        String?
  hirerPhone          String?
  hirerEmail          String?
  /// Tài khoản ngân hàng bên thuê (số TK, ngân hàng)
  hirerBank           String?
  hirerRepresentative String? // Người đại diện ký (tổ chức)
  hirerPosition       String?
  hirerRepIdNumber    String?
  paymentMethod       String?
  extraTerms          String?
  /// Mã bí mật của bản hợp đồng điện tử (QR / đường dẫn cho lái xe, khách)
  token               String    @unique
  /// Bên thuê xác nhận đồng ý hợp đồng điện tử
  acceptedAt          DateTime?
  acceptedName        String?
  acceptedIp          String?
  createdById         Int
  createdBy           User      @relation("ContractCreator", fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([year, seq])
}

/// Sự cố lái xe báo từ app (hỏng xe, va chạm, trễ giờ, khách vắng mặt…): điều hành nhận thông báo và xử lý
model FieldIncident {
  id          Int          @id @default(autoincrement())
  tripId      Int?
  trip        BookingTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId    Int
  driver      Driver       @relation(fields: [driverId], references: [id])
  vehicleId   Int?
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  /// HONG_XE | VA_CHAM | TRE_GIO | KHACH_VANG | DOI_LICH_TRINH | KHAC
  type        String
  note        String
  /// Ảnh hiện trường (tên file trong uploads/field)
  photos      String[]     @default([])
  /// MOI | DANG_XU_LY | DA_XU_LY
  status      String       @default("MOI")
  handleNote  String?
  handledById Int?
  handledBy   User?        @relation("IncidentHandler", fields: [handledById], references: [id])
  handledAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([tripId])
}

/// Check-in nhận xe / trả xe của lái xe: km đồng hồ, nhiên liệu, danh mục kiểm tra, ảnh xe
model VehicleCheck {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId   Int
  driver     Driver   @relation(fields: [driverId], references: [id])
  /// NHAN | TRA
  kind       String
  odometerKm Int?
  /// Mức nhiên liệu (%): 0 | 25 | 50 | 75 | 100
  fuelLevel  Int?
  /// [{ key, label, ok, note }]
  items      Json     @default("[]")
  /// Số hạng mục lỗi
  defects    Int      @default(0)
  photos     String[] @default([])
  note       String?
  createdAt  DateTime @default(now())

  @@index([vehicleId, createdAt])
  @@index([driverId, createdAt])
}

model TripEvent {
  id        Int         @id @default(autoincrement())
  tripId    Int
  trip      BookingTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status    TripStatus
  note      String?
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@index([tripId])
}

// ───────────── Tài chính ─────────────

enum PaymentMethod {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
  KHAC
}

/// Danh mục loại chi phí chuyến (xăng dầu, cầu đường…)
model CostCategory {
  code          String        @id
  name          String
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  /// Lái xe được chọn loại này khi nhập chi phí trên app (lương, tạm ứng… thì tắt)
  driverVisible Boolean       @default(true)
  costs         TripCost[]
  vouchers      CashVoucher[]
}

/// Chi phí thực tế phát sinh của chuyến
model TripCost {
  id           Int          @id @default(autoincrement())
  tripId       Int
  trip         BookingTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  categoryCode String
  category     CostCategory @relation(fields: [categoryCode], references: [code], onUpdate: Cascade)
  amount       Decimal      @db.Decimal(15, 0)
  spentAt      DateTime     @default(now()) @db.Date
  note         String?
  byDriver     Boolean      @default(false) // Lái xe nhập trên app
  receiptFile  String? // Ảnh hóa đơn / vé (lưu trong uploads/receipts)
  receiptType  String? // image/jpeg, image/png, image/webp
  createdById  Int?
  createdBy    User?        @relation("CostCreator", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([tripId])
  @@index([spentAt])
}

/// Phiếu thu tiền khách (số âm = hoàn tiền)
model Payment {
  collectTrip BookingTrip?  @relation("TripCollect")
  id          Int           @id @default(autoincrement())
  bookingId   Int
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(15, 0)
  method      PaymentMethod @default(CHUYEN_KHOAN)
  paidAt      DateTime      @db.Date
  reference   String? // Số chứng từ / mã giao dịch
  note        String?
  createdById Int
  createdBy   User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([bookingId])
  @@index([paidAt])
}

/// Thanh toán cho nhà xe đối tác
model PartnerPayment {
  id          Int           @id @default(autoincrement())
  partnerId   Int
  partner     Partner       @relation(fields: [partnerId], references: [id])
  amount      Decimal       @db.Decimal(15, 0)
  method      PaymentMethod @default(CHUYEN_KHOAN)
  paidAt      DateTime      @db.Date
  reference   String?
  note        String?
  createdById Int
  createdBy   User          @relation("PartnerPaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([partnerId])
  @@index([paidAt])
}

enum VoucherType {
  THU
  CHI
}

/// Phiếu thu / phiếu chi lập tay trong sổ thu chi, gắn với xe (công ty hoặc đối tác)
model CashVoucher {
  id             Int             @id @default(autoincrement())
  code           String          @unique // PT2610-0001 / PC2610-0001
  type           VoucherType
  date           DateTime        @db.Date
  categoryCode   String?
  category       CostCategory?   @relation(fields: [categoryCode], references: [code], onUpdate: Cascade)
  title          String? // Khoản mục tự ghi (khi không chọn loại chi phí)
  vehicleId      Int?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  partnerId      Int?
  partner        Partner?        @relation(fields: [partnerId], references: [id])
  counterparty   String? // Người nộp / người nhận
  amount         Decimal         @db.Decimal(15, 0)
  method         PaymentMethod   @default(TIEN_MAT)
  reference      String?
  note           String?
  /// Xăng dầu lái xe nhập trên app
  driverId       Int?
  driver         Driver?         @relation(fields: [driverId], references: [id])
  liters         Decimal?        @db.Decimal(8, 2)
  odometerKm     Int?
  driverPaid     Boolean         @default(false) // Lái xe tự ứng tiền → hoàn ứng trong lương
  receiptFile    String?
  receiptType    String?
  /// Phiếu chi tạm ứng lập từ đề nghị của lái xe
  advanceRequest AdvanceRequest?
  createdById    Int
  createdBy      User            @relation("VoucherCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([date])
  @@index([vehicleId])
  @@index([partnerId])
  @@index([driverId])
}

// ───────────── Lái xe đề nghị tạm ứng ─────────────

enum AdvanceStatus {
  CHO_DUYET // Lái xe vừa gửi, chờ văn phòng
  DA_CHI // Văn phòng đã duyệt và chi tiền (có phiếu chi)
  TU_CHOI
  DA_HUY // Lái xe tự hủy khi chưa duyệt
}

model AdvanceRequest {
  id           Int           @id @default(autoincrement())
  driverId     Int
  driver       Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(15, 0) // Số tiền lái xe xin ứng
  reason       String
  status       AdvanceStatus @default(CHO_DUYET)
  decidedAt    DateTime?
  decidedById  Int?
  decidedBy    User?         @relation("AdvanceDecider", fields: [decidedById], references: [id])
  decisionNote String? // Lý do từ chối / ghi chú khi chi
  voucherId    Int?          @unique
  voucher      CashVoucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([driverId])
  @@index([status])
}

// ───────────── Thông báo (chuông trên web văn phòng và app lái xe) ─────────────

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// BOOKING_NEW | BOOKING_CONFIRMED | COLLECTED | ADVANCE_NEW | TRIP_REJECTED | TRIP_NEW | TRIP_MOVED | TRIP_CHANGED | TRIP_CANCELLED | COLLECT_REQUEST | ADVANCE_DONE | COLLECT_SETTLED
  type      String
  title     String
  body      String
  /// Đường dẫn trên web (vd. /bookings/12)
  link      String?
  /// Chuyến liên quan (app lái xe mở chi tiết chuyến)
  tripId    Int?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ───────────── Nhật ký thao tác ─────────────

/// Ghi lại mọi thao tác thêm / sửa / xóa / đổi trạng thái và đăng nhập (giữ tên người làm kể cả khi tài khoản đã xóa)
model AuditLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  userId      Int?
  userName    String?
  /// Mô tả thao tác, vd. "Sửa booking", "Điều xe", "Đăng nhập"
  action      String
  method      String
  path        String
  /// Loại đối tượng: Booking, Trip, Payment, Vehicle, Driver, User…
  entity      String?
  entityId    String?
  /// Tên dễ đọc của đối tượng: mã booking, biển số, họ tên…
  entityLabel String?
  /// Booking liên quan (để xem lịch sử trong từng booking)
  bookingId   Int?
  detail      String?
  /// Chi tiết thay đổi: [{ field, from, to }]
  changes     Json?
  ip          String?
  success     Boolean  @default(true)

  @@index([createdAt])
  @@index([bookingId])
  @@index([userId])
  @@index([entity, entityId])
}

// ───── Xe ghép (shared shuttle bus) ─────

enum ShuttleStopKind {
  DIEM_DUNG // Điểm dừng cố định: khách tự ra điểm
  KHU_VUC // Khu vực đón / trả tận khách sạn
}

enum ShuttleRunStatus {
  MO_BAN
  DONG_BAN
  HUY
}

/// Tuyến xe ghép: giá vé / ghế, xe mặc định, số ghế bán
model ShuttleRoute {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  name            String
  vehicleTypeId   Int
  vehicleType     VehicleType       @relation(fields: [vehicleTypeId], references: [id])
  /// Số ghế bán mỗi chuyến (mặc định)
  capacity        Int
  /// Thời gian chạy dự kiến từ giờ xuất bến đến điểm cuối (phút)
  durationMinutes Int               @default(60)
  adultPrice      Decimal           @db.Decimal(15, 0)
  childPrice      Decimal           @default(0) @db.Decimal(15, 0)
  /// Giá cho khách hàng là đại lý (bỏ trống = giá thường)
  agentAdultPrice Decimal?          @db.Decimal(15, 0)
  agentChildPrice Decimal?          @db.Decimal(15, 0)
  notes           String?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  stops           ShuttleStop[]
  schedules       ShuttleSchedule[]
  runs            ShuttleRun[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Điểm dừng / khu vực đón trên tuyến, theo thứ tự chạy
model ShuttleStop {
  id            Int             @id @default(autoincrement())
  routeId       Int
  route         ShuttleRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  seq           Int
  name          String
  kind          ShuttleStopKind @default(DIEM_DUNG)
  address       String?
  /// Giờ đón dự kiến = giờ xuất bến + số phút này
  offsetMinutes Int             @default(0)
  /// Phụ phí mỗi ghế khi đón / trả ở đây (khu vực xa)
  surcharge     Decimal         @default(0) @db.Decimal(15, 0)
  canPickup     Boolean         @default(true)
  canDropoff    Boolean         @default(true)
  isActive      Boolean         @default(true)
  pickups       BookingTrip[]   @relation("ShuttlePickup")
  dropoffs      BookingTrip[]   @relation("ShuttleDropoff")
}

/// Giờ xuất bến cố định của tuyến
model ShuttleSchedule {
  id         Int          @id @default(autoincrement())
  routeId    Int
  route      ShuttleRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  /// "HH:mm" giờ Việt Nam
  departTime String
  /// Ngày trong tuần chạy: 1 = Thứ Hai … 7 = Chủ nhật; trống = mọi ngày
  weekdays   Int[]
  validFrom  DateTime?    @db.Date
  validTo    DateTime?    @db.Date
  /// Số ghế bán (trống = theo tuyến)
  capacity   Int?
  isActive   Boolean      @default(true)
  runs       ShuttleRun[]
}

/// Chuyến xe ghép cụ thể (tuyến + giờ xuất bến); điều xe một lần cho cả chuyến
model ShuttleRun {
  id                 Int              @id @default(autoincrement())
  routeId            Int
  route              ShuttleRoute     @relation(fields: [routeId], references: [id])
  scheduleId         Int?
  schedule           ShuttleSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  departAt           DateTime
  capacity           Int
  vehicleTypeId      Int
  vehicleType        VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  status             ShuttleRunStatus @default(MO_BAN)
  note               String?
  vehicleId          Int?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])
  driverId           Int?
  driver             Driver?          @relation(fields: [driverId], references: [id])
  partnerId          Int?
  partner            Partner?         @relation(fields: [partnerId], references: [id])
  partnerPlate       String?
  partnerDriverName  String?
  partnerDriverPhone String?
  /// Giá thuê nhà xe cả chuyến (chưa thuế)
  partnerCost        Decimal?         @db.Decimal(15, 0)
  /// Chi phí dự kiến cả chuyến khi chạy xe công ty
  estimatedCost      Decimal?         @db.Decimal(15, 0)
  dispatchNote       String?
  assignedAt         DateTime?
  trips              BookingTrip[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([routeId, departAt])
  @@index([departAt])
}
